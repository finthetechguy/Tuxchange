#!/bin/bash
# Set up a monitor interface, run sp_probe_tx.py, and put the machine back.
#   sudo ./scripts/tuxchange-probe [iface] [channels] [sp_probe_tx.py arguments]
set -u

IFACE=${1:-}          # empty: sp_monitor.sh picks a usable adapter
CHANS=${2:-1,6,11}
shift 2 2>/dev/null || shift $# 2>/dev/null
MON=${SP_MON:-mon0}
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=python3

if [ "$(id -u)" -ne 0 ]; then
  echo "needs root (raw AF_PACKET socket + iw). Re-run with sudo."
  exit 1
fi

OURMAC=${OURMAC:-$(printf 'ba:ae:6e:%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))}

cleanup() {
  echo
  echo "cleaning up..."
  SP_IFACE=$IFACE SP_MON=$MON "$HERE/sp_monitor.sh" down
}
trap cleanup EXIT INT TERM

SP_IFACE=$IFACE SP_MON=$MON SP_MAC=$OURMAC SP_CHANNELS=$CHANS "$HERE/sp_monitor.sh" up || exit 1
[ -r /run/tuxchange.iface ] && IFACE=$(cat /run/tuxchange.iface)

PHY=$(cat "/sys/class/net/$IFACE/phy80211/name" 2>/dev/null)
DRIVER=$(basename "$(readlink -f "/sys/class/net/$IFACE/device/driver" 2>/dev/null)" 2>/dev/null)
echo "interface $IFACE  ($PHY, driver ${DRIVER:-unknown})"

case "$DRIVER" in
  ath9k*) ;;
  mt7921*|mt76*)
    echo
    echo "############################################################################"
    echo "# WARNING: $DRIVER. The MT7902 has never been shown to inject."
    echo "#   An injection test sent 154 frames from this chip, and an ath9k receiver"
    echo "#   on the same channel a metre away caught none of them. Its MAC runs in"
    echo "#   vendor firmware. Use an ath9k card instead."
    echo "#   Continuing in 5 s. Rung 0 (TX proof) will show whether it transmits."
    echo "############################################################################"
    sleep 5 ;;
  *) echo "  (untested driver; rung 0 will report whether it transmits)" ;;
esac

# debugfs has ath9k's hardware TX counters, the strongest proof a frame left the radio.
if [ -d /sys/kernel/debug ] && ! mountpoint -q /sys/kernel/debug 2>/dev/null; then
  mount -t debugfs none /sys/kernel/debug 2>/dev/null \
    && echo "mounted debugfs (for ath9k hardware TX counters)"
fi
# Only ath9k has them; check the radio in use, not any radio on the machine.
if [ -e "/sys/kernel/debug/ieee80211/$PHY/ath9k/xmit" ]; then
  echo "ath9k hardware TX counters: available"
else
  echo "no hardware TX counters on $PHY; our own frames echoed back will be the TX proof"
fi

echo "regulatory domain: $(iw reg get 2>/dev/null | sed -n 's/^country /  country /p' | head -1)"
echo "  (channels 1/6/11 are legal everywhere, so Stage 1 needs no regulatory change)"
echo

"$PY" "$ROOT/tuxchange/sp_probe_tx.py" --iface "$MON" --channels "$CHANS" "$@"
RC=$?
exit $RC
