#!/bin/bash
# Run sp_link.py once by hand, with a capture and a log, for debugging.
#   sudo ./scripts/tuxchange-link [iface] [channel] [sp_link.py arguments]
# WARNING: arms a forced SysRq reboot before touching the radio, cancelled on a clean exit.
set -u

IFACE=${1:-}          # empty: sp_monitor.sh picks a usable adapter
CH=${2:-1,6,11}
shift 2 2>/dev/null || shift $# 2>/dev/null
MON=${SP_MON:-mon0}
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=python3
# The reboot timer must outlive the run, so derive it from --secs.
RUN_SECS=$(printf '%s\n' "$@" | awk '/^--secs$/{getline; print; exit}')
: "${RUN_SECS:=180}"
DEADMAN_MIN=${DEADMAN_MIN:-$(( RUN_SECS / 60 + 8 ))}

if [ "$(id -u)" -ne 0 ]; then echo "needs root; re-run with sudo."; exit 1; fi

DEADMAN_ARMED=0
# Not `shutdown -r +N`: it writes /run/nologin, which blocks the SSH login needed to cancel it.
arm_deadman() {
  # SysRq, because a soft reboot hangs on the rtnl_lock a driver oops leaves held.
  if command -v systemd-run >/dev/null; then
    systemctl stop sp-deadman.timer >/dev/null 2>&1
    systemd-run --on-active="${DEADMAN_MIN}min" --unit=sp-deadman /bin/sh -c \
      'echo 1 > /proc/sys/kernel/sysrq; echo b > /proc/sysrq-trigger' >/dev/null 2>&1 \
      && DEADMAN_ARMED=1
  fi
  [ "$DEADMAN_ARMED" -eq 1 ] \
    && echo "forced reboot armed (+${DEADMAN_MIN} min); cancelled automatically on a clean exit" \
    || echo "WARNING: could not arm the forced reboot!"
}
disarm_deadman() {
  [ "$DEADMAN_ARMED" -eq 1 ] || return 0
  systemctl stop sp-deadman.timer >/dev/null 2>&1
  systemctl reset-failed sp-deadman.service >/dev/null 2>&1
  echo "forced reboot cancelled"
}

OURMAC=${OURMAC:-$(printf 'ba:ae:6e:%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))}

cleanup() {
  echo
  echo "cleaning up..."
  SP_IFACE=$IFACE SP_MON=$MON "$HERE/sp_monitor.sh" down
  disarm_deadman
}
trap cleanup EXIT INT TERM

arm_deadman
SP_IFACE=$IFACE SP_MON=$MON SP_MAC=$OURMAC SP_CHANNELS=$CH "$HERE/sp_monitor.sh" up || exit 1
[ -r /run/tuxchange.iface ] && IFACE=$(cat /run/tuxchange.iface)
DRIVER=$(basename "$(readlink -f "/sys/class/net/$IFACE/device/driver" 2>/dev/null)" 2>/dev/null)
echo "interface $IFACE (driver ${DRIVER:-unknown}), channel $CH"
echo

# Only ath9k has hardware TX counters; check the radio in use, not any radio on the machine.
PHY=$(cat "/sys/class/net/$IFACE/phy80211/name" 2>/dev/null)
XMIT=/sys/kernel/debug/ieee80211/$PHY/ath9k/xmit
if [ -e "$XMIT" ]; then
  echo "ath9k hardware TX counters: available"
else
  mount -t debugfs none /sys/kernel/debug 2>/dev/null
  [ -e "$XMIT" ] \
    && echo "ath9k hardware TX counters: available (mounted debugfs)" \
    || echo "no hardware TX counters on $PHY; frames echoed back will be the TX proof"
fi
echo

TS=$(date +%s)
# --mac must match the interface MAC or the hardware will not ACK what we claim to be.
"$PY" "$ROOT/tuxchange/sp_link.py" --iface "$MON" --channel "$CH" --mac "$OURMAC" \
     --pcap "$ROOT/stage2_${TS}.pcap" --log "$ROOT/stage2_${TS}.log" "$@"
RC=$?
echo
echo "artifacts: stage2_${TS}.pcap  stage2_${TS}.log"
exit $RC
